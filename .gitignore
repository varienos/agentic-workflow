# ─────────────────────────────────────────────────────
# THIS PROJECT'S OWN DEVELOPMENT ENVIRONMENT
# (not part of the template; does not enter the repo)
# ─────────────────────────────────────────────────────

# Root .claude/ — CC config used to develop this project
# (project-specific commands such as task-hunter.md, task-plan.md live here)
/.claude/
/.gemini/
/.agent/

# Root CLAUDE.md — this project's own CC instruction file
/CLAUDE.md

# Root backlog — this project's own task tracking (IGNORE — does NOT enter the repo)
# Project-specific task tracking
/backlog/

# Release temporary files
.release-notes.tmp

# Other project-specific root files
AGENTS.md
GEMINI.md
.copilot/
.codex/
.github/copilot-instructions.md

# ─────────────────────────────────────────────────────
# BOOTSTRAP OUTPUT INSIDE AGENTBASE
# (not part of the template; produced for the target project)
# ─────────────────────────────────────────────────────

# Bootstrap outputs — created after /bootstrap runs
Agentbase/.claude/settings.local.json
Agentbase/.claude/settings.json
Agentbase/.claude/CLAUDE.md
Agentbase/.claude/agents/
Agentbase/.claude/hooks/
Agentbase/.claude/rules/
Agentbase/.claude/custom/
Agentbase/.mcp.json
Agentbase/.claude-ignore
Agentbase/CLAUDE.md

# Transform outputs (produced by transform.js — target CLI configurations)
Agentbase/.gemini/
Agentbase/.codex/
Agentbase/.kimi/
Agentbase/.opencode/
Agentbase/GEMINI.md
Agentbase/AGENTS.md

# Runtime data (session-based)
Agentbase/.claude/tracking/sessions/session-*.json
Agentbase/.claude/reports/deploys/deploy-*.md
Agentbase/.claude/hooks/.test-reminder-state.json
Agentbase/.claude/hooks/.drift-state.json

# Agentbase backlog (bootstrap produces this for the target project)
Agentbase/backlog/

# ─────────────────────────────────────────────────────
# FILES THAT REMAIN IN THE REPO (the following are TRACKED):
#
# Agentbase/.claude/commands/bootstrap.md  ← Template bootstrap command
# Agentbase/templates/                     ← Skeleton files (core of the template)
# Agentbase/generate.js                    ← Deterministic generation script
# Agentbase/bin/session-monitor.js         ← Session monitoring tool
# Agentbase/tests/                         ← Test suite
# Agentbase/*.md stubs                     ← Bootstrap will fill these
# Docbase/superpowers/                      ← Spec and plan documents
# ─────────────────────────────────────────────────────

# Superpowers docs (spec/plan files — for local development; do NOT enter the repo)
/docs/

# Test environment (used for bootstrap tests; contents ignored)
test/*
!test/.gitkeep

# Template repo placeholder: Codebase/.gitkeep stays tracked so the
# Codebase/ directory appears after clone. The root-gitignore.skeleton that
# bootstrap writes into the target project root is stricter and ignores all of Codebase/.
Codebase/*
!Codebase/.gitkeep

# Codebase git worktree directories are also not tracked in the upper-root developer repo.
# Root-anchored (/): only worktrees at the repo root — not nested Codebase-wt-* paths.
/Codebase-wt-*/

# Docbase (Bootstrap produces — project-specific)
Docbase/agentic/project-manifest.yaml
/Docbase/superpowers/
/Docbase/agentic/

# Git worktrees (used by the superpowers skill)
.worktrees/
