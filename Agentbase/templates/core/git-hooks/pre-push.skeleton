#!/bin/bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Pre-push Hook — Generated by Bootstrap
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# This hook runs when a git push is made in Codebase.
# Setup: cd ../Codebase && git config core.hooksPath "$(realpath ../Agentbase/git-hooks/)"
#
# Checks:
#   1. Localhost leak scan (excluding test files)
#   2. ORM migration consistency (schema vs migration)
#   3. Env variable synchronization
#   4. Destructive migration warning (WARN — push continues)

ERRORS=0
WARNINGS=0
CODEBASE_DIR="$(git rev-parse --show-toplevel)"

# Commit range to push is read from stdin
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    # Branch is being deleted; check unnecessary
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch — check from the divergence point from the default branch
    DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")
    MERGE_BASE=$(git merge-base "$local_sha" "origin/$DEFAULT_BRANCH" 2>/dev/null || true)
    if [ -n "$MERGE_BASE" ]; then
      RANGE="$MERGE_BASE..$local_sha"
    else
      # If merge-base not found, scan from the first commit
      RANGE="$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | tail -1)..$local_sha"
    fi
  else
    RANGE="$remote_sha..$local_sha"
  fi

  echo ""
  echo "━━━ Pre-push Checks ━━━"
  echo "  Branch: $local_ref"
  echo ""

  # ─── LOCALHOST LEAK SCAN ───
  # Search changes to push for localhost/127.0.0.1 references
  # Test files and configuration files are excluded
<!-- GENERATE: GIT_PREPUSH_LOCALHOST
Localhost leak scan:
- Searches git diff for localhost, 127.0.0.1, 0.0.0.0
- Test files excluded (*.test.*, *.spec.*, __tests__/)
- Config files excluded (docker-compose*, .env.example)
- If detected, ERRORS=1
-->

  # ─── ORM MIGRATION CONSISTENCY ───
<!-- GENERATE: GIT_PREPUSH_MIGRATION
Migration consistency is checked by ORM:
- Prisma: FAIL if schema.prisma changed but no new migration under prisma/migrations/
- TypeORM: FAIL if entity file changed but no new migration under src/migrations/
- Eloquent: WARN if Model changed but no new migration under database/migrations/
- Django: FAIL if models.py changed but no new migration under migrations/
-->

  # ─── ENV VARIABLE SYNCHRONIZATION ───
<!-- GENERATE: GIT_PREPUSH_ENV
Env variable consistency is checked:
- If .env.example exists: compare its keys with process.env/os.environ references in the codebase
- If a Zod schema exists (env.ts, env.mjs): compare schema keys with .env.example
- If docker-compose.yml exists: compare environment section with .env.example
- If inconsistent, WARN (push continues)
-->

  # ─── DESTRUCTIVE MIGRATION WARNING ───
<!-- GENERATE: GIT_PREPUSH_DESTRUCTIVE
Destructive migration patterns are scanned:
- DROP TABLE, DROP COLUMN, ALTER TABLE ... DROP
- Prisma: DROP inside migration.sql
- Django: RemoveField, DeleteModel inside migrations/
- Eloquent: dropColumn, dropTable
- If detected, WARN (push continues, but warns)
-->

  # ─── TRIAL MERGE CHECK ───
  # Before push, check whether there is a merge conflict with main/master
  # If there is a conflict, push is blocked — rebase/merge first
  DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

  if [ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]; then
    git fetch origin "$DEFAULT_BRANCH" --quiet 2>/dev/null || true
    # git merge-tree --write-tree (git >= 2.38) reports conflict via exit code
    # On older git versions, fall back to the 3-tree form + grep
    if git merge-tree --write-tree HEAD "origin/$DEFAULT_BRANCH" >/dev/null 2>&1; then
      : # No conflict
    else
      MERGE_EXIT=$?
      if [ "$MERGE_EXIT" -eq 1 ]; then
        echo "❌ Merge conflict with $DEFAULT_BRANCH detected!"
        echo "   Rebase or merge before push:"
        echo "     git fetch origin $DEFAULT_BRANCH"
        echo "     git rebase origin/$DEFAULT_BRANCH"
        ERRORS=1
      fi
      # Exit code 128+ = git command unsupported or other error — skip silently
    fi
  fi

done

# ─── RESULT ───
echo ""
if [ "$WARNINGS" -gt 0 ]; then
  echo "⚠️  $WARNINGS warning(s) detected (push continuing)"
fi

if [ "$ERRORS" -ne 0 ]; then
  echo "━━━ Pre-push FAILED ━━━"
  exit 1
fi

echo "━━━ Pre-push OK ━━━"
exit 0
