#!/bin/bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Pre-commit Hook — Generated by Bootstrap
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# This hook runs when a git commit is made in Codebase.
# Setup: cd ../Codebase && git config core.hooksPath "$(realpath ../Agentbase/git-hooks/)"
#
# Bypass: TESTS_VERIFIED=1 git commit -m "..."
#
# Checks:
#   1. Security scan (hardcoded secret, .env file)
#   2. Compile check (TypeScript, Go, Rust — by stack)
#   3. Test run (jest, pytest, phpunit — by stack)
#   4. Lint check (eslint, phpcs, ruff — by stack)
#   5. Format check (prettier, biome — by stack)

# ─── TESTS_VERIFIED BYPASS ───
if [ "${TESTS_VERIFIED}" = "1" ]; then
  echo "✓ TESTS_VERIFIED=1 — skipping pre-commit checks"
  exit 0
fi

ERRORS=0
CODEBASE_DIR="$(git rev-parse --show-toplevel)"

echo ""
echo "━━━ Pre-commit Checks ━━━"
echo ""

# ─── SECURITY SCAN ───
# Search staged files for hardcoded secrets and .env files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$STAGED_FILES" ]; then
  # .env file commit check
  ENV_FILES=$(echo "$STAGED_FILES" | grep -E '\.env$|\.env\.local$|\.env\.production$|\.env\.staging$' || true)
  if [ -n "$ENV_FILES" ]; then
    echo "❌ .env files cannot be committed!"
    echo "   Blocked files:"
    echo "$ENV_FILES" | sed 's/^/     /'
    ERRORS=1
  fi

  # Hardcoded secret scan (on staged diff)
  STAGED_DIFF=$(git diff --cached --unified=0 2>/dev/null || true)
  if [ -n "$STAGED_DIFF" ]; then
    # API key patterns
    if echo "$STAGED_DIFF" | grep -qE 'sk-[a-zA-Z0-9]{20,}'; then
      echo "❌ Hardcoded API key detected (sk-... pattern)!"
      ERRORS=1
    fi
    # AWS access key
    if echo "$STAGED_DIFF" | grep -qE '(AKIA|ASIA)[A-Z0-9]{16}'; then
      echo "❌ AWS access key detected!"
      ERRORS=1
    fi
    # Private key
    if echo "$STAGED_DIFF" | grep -qE '\-\-\-\-\-BEGIN.*PRIVATE KEY\-\-\-\-\-'; then
      echo "❌ Private key detected!"
      ERRORS=1
    fi
    # Generic secret assignment (password = "...", secret = "...")
    if echo "$STAGED_DIFF" | grep -qEi '(password|secret|token|api_key)\s*[:=]\s*["\x27][^"\x27]{4,}["\x27]'; then
      echo "⚠️  Possible hardcoded credential detected — please review."
    fi
  fi
fi

# ─── COMPILE CHECK ───
<!-- GENERATE: GIT_PRECOMMIT_COMPILE
Compile check is added by stack:
- If TypeScript: npx tsc --noEmit
- If Go: go build ./...
- If Rust: cargo check
-->

# ─── TEST CHECK ───
<!-- GENERATE: GIT_PRECOMMIT_TEST
Test command is added by stack:
- jest/vitest/mocha: npm test or npx jest
- pytest: python -m pytest
- phpunit: ./vendor/bin/phpunit
- go test: go test ./...
-->

# ─── LINT CHECK ───
<!-- GENERATE: GIT_PRECOMMIT_LINT
Lint check is added by stack:
- eslint: npx eslint --quiet (staged files)
- biome: npx biome check (staged files)
- phpcs: ./vendor/bin/phpcs (staged files)
- ruff: ruff check (staged files)
-->

# ─── FORMAT CHECK ───
<!-- GENERATE: GIT_PRECOMMIT_FORMAT
If a formatter exists, checks staged files:
- prettier: npx prettier --check (staged files)
- biome: npx biome format --check (staged files)
- ruff: ruff format --check (staged files)
-->

# ─── RESULT ───
echo ""
if [ "$ERRORS" -ne 0 ]; then
  echo "━━━ Pre-commit FAILED ━━━"
  echo "Bypass: TESTS_VERIFIED=1 git commit -m \"...\""
  exit 1
fi

echo "━━━ Pre-commit OK ━━━"
exit 0
